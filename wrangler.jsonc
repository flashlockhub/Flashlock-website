{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flashlock-website",
  "compatibility_date": "2026-09-03",
  // This is the existing asset-only workers.dev site, NOT the CSP adapter.
  // No routes/custom domains: flashlock.app remains GitHub Pages + adapter.
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
